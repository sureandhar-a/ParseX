<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>WarnPkg</SHORT-NAME>
      <ELEMENTS>
        <CLUSTER>
          <SHORT-NAME>NoBaud</SHORT-NAME>
          <PHYSICAL-CHANNELS>
            <PHYSICAL-CHANNEL>
              <SHORT-NAME>ch0</SHORT-NAME>
            </PHYSICAL-CHANNEL>
          </PHYSICAL-CHANNELS>
        </CLUSTER>
        <CLUSTER>
          <BAUDRATE>500000</BAUDRATE>
        </CLUSTER>
        <ECU-INSTANCE>
          <SHORT-NAME>Lonely</SHORT-NAME>
        </ECU-INSTANCE>
        <FRAME>
          <SHORT-NAME>Empty</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </FRAME>
        <FRAME>
          <SHORT-NAME>NoLen</SHORT-NAME>
          <PDUS>
            <FRAME-PDU>
              <PDU-REF>/WarnPkg/NoLenPdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </FRAME-PDU>
          </PDUS>
        </FRAME>
        <PDU>
          <SHORT-NAME>NoLenPdu</SHORT-NAME>
          <SIGNAL-MAPPINGS>
            <PDU-SIGNAL-MAPPING>
              <SIGNAL-REF>/WarnPkg/NoBits</SIGNAL-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-SIGNAL-MAPPING>
          </SIGNAL-MAPPINGS>
        </PDU>
        <PDU>
          <SHORT-NAME>NoMap</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </PDU>
        <I-SIGNAL>
          <SHORT-NAME>NoLengthSignal</SHORT-NAME>
        </I-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>Stub</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <SIGNAL-GROUP>
          <SHORT-NAME>NoMembers</SHORT-NAME>
        </SIGNAL-GROUP>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
