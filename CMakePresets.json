{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Debug)",
      "description": "Default debug build configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O0"
      },
      "hidden": false
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimized release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "hidden": false
    },
    {
      "name": "build-asan",
      "displayName": "AddressSanitizer",
      "description": "Build with AddressSanitizer enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "PARSEX_ENABLE_SANITIZERS": "ON"
      },
      "hidden": false
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "build-asan",
      "configurePreset": "build-asan"
    }
  ],
    "testPresets":[
      {
      "name": "default",
      "displayName": "Default Test Run",
      "description": "Runs all tests with verbose output on failure",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    }
    ]
}
