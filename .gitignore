build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

#visual studio code
.vscode/

#to ignore local downloads
downloads/

# AUTOSAR XSD schemas are user-supplied, never committed (see
# resources/schemas/README.md and docs/decisions/0002-*.md). The directory
# layout and README are tracked; the copyrighted .xsd files are not.
# Exception: xml.xsd is W3C-licensed (not AUTOSAR-copyrighted) and required
# alongside every schema, so it IS committed.
resources/schemas/*.xsd
!resources/schemas/xml.xsd

#Python cache
*/__pycache__

#spike folder
spikes/*

# libFuzzer runtime artifacts (crashers/hangs/leaks land in the fuzzer's CWD).
# The seed corpus (fuzz/corpus/) IS committed; everything a fuzz run
# generates is not.
crash-*
oom-*
timeout-*
leak-*
